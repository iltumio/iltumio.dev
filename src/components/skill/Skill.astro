---
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<div class="flex flex-col items-center justify-center gap-2 px-7 sm:px-9 shrink-0">
  <div
    class="text-gray-500 dark:text-gray-400 [&>svg]:h-9 [&>svg]:w-9"
    aria-hidden="true"
  >
    <slot name="icon" />
  </div>
  <span class="whitespace-nowrap text-sm font-medium text-gray-600 dark:text-gray-300">
    {name}
  </span>
</div>
