---
import { Icon } from 'astro-icon/components';

interface Props {
  image: string;
  name: string;
  description: string;
  link: string;
  from: string;
  to: string;
  role: string;
  linkedin?: string;
  twitter?: string;
}

const {
  image,
  name,
  description,
  from,
  to,
  role,
  link,
  linkedin,
  twitter,
} = Astro.props;
---

<div class="flex flex-col gap-2.5 rounded-xl border border-gray-100 bg-white px-3.5 py-2.5 sm:flex-row sm:items-center sm:gap-4 sm:px-4 dark:border-gray-800 dark:bg-gray-900">
  <a
    href={link}
    target="_blank"
    rel="noreferrer"
    class="flex min-w-0 flex-1 items-center gap-3 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600"
  >
    <span class="flex size-9 shrink-0 items-center justify-center overflow-hidden rounded-lg border border-gray-100 bg-gray-50 p-1.5 dark:border-gray-700 dark:bg-gray-800">
      <img src={image} alt="" class="max-h-full max-w-full object-contain dark:invert" />
    </span>
    <span class="min-w-0 text-left">
      <span class="block text-sm font-semibold leading-snug text-gray-900 dark:text-white">
        {role}
        <span class="font-medium text-gray-500 dark:text-gray-400"> · {name}</span>
      </span>
      <span class="mt-0.5 block text-sm leading-snug text-gray-500 dark:text-gray-400">
        {description}
      </span>
    </span>
  </a>

  <div class="flex items-center justify-between gap-3 pl-12 sm:justify-end sm:pl-0">
    <span class="whitespace-nowrap text-xs font-medium text-gray-500 dark:text-gray-400">
      {from} – {to}
    </span>
    {(linkedin || twitter) && (
      <span class="flex items-center">
        {linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noreferrer"
            class="inline-flex size-8 items-center justify-center text-gray-400 transition-colors hover:text-[#0077b5] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600"
            aria-label={`${name} on LinkedIn`}
          >
            <Icon name="simple-icons:linkedin" class="size-4" />
          </a>
        )}
        {twitter && (
          <a
            href={twitter}
            target="_blank"
            rel="noreferrer"
            class="inline-flex size-8 items-center justify-center text-gray-400 transition-colors hover:text-black focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:hover:text-white"
            aria-label={`${name} on X`}
          >
            <Icon name="simple-icons:x" class="size-4" />
          </a>
        )}
      </span>
    )}
  </div>
</div>
