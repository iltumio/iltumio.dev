---
import { Icon } from 'astro-icon/components';

interface Props {
  image: string;
  name: string;
  description: string;
  link: string;
  from: string;
  to: string;
  role: string;
  linkedin?: string;
  twitter?: string;
}

const {
  image,
  name,
  description,
  from,
  to,
  role,
  link,
  linkedin,
  twitter,
} = Astro.props;
---

<div class="rounded-xl border border-gray-100 bg-white transition-shadow duration-200 hover:shadow-lg dark:border-gray-800 dark:bg-gray-900">
  <div class="flex flex-col gap-5 p-5 sm:flex-row sm:p-6">
    <div class="shrink-0">
      <div class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-xl border border-gray-100 bg-gray-50 p-3 dark:border-gray-700 dark:bg-gray-800 sm:h-18 sm:w-18">
        <img
          src={image}
          alt={name}
          class="max-h-full max-w-full object-contain"
        />
      </div>
    </div>

    <div class="flex flex-1 flex-col gap-1.5">
      <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
        <div class="space-y-0.5">
          <h3 class="text-xl font-bold text-gray-900 dark:text-white">
            {name}
          </h3>
          <p class="text-base font-medium text-gray-600 dark:text-gray-300">
            {role}
          </p>
        </div>
        <span class="inline-flex self-start whitespace-nowrap rounded-full bg-gray-100 px-2.5 py-1 text-xs font-medium text-gray-500 dark:bg-gray-800 dark:text-gray-400">
          {from} - {to}
        </span>
      </div>

      <p class="mt-1 max-w-2xl text-sm leading-relaxed text-gray-600 dark:text-gray-400">
        {description}
      </p>

      {(linkedin || twitter || link) && (
        <div class="mt-3 flex items-center gap-3">
          {link && (
            <a
              href={link}
              target="_blank"
              rel="noreferrer"
              class="text-gray-400 transition-colors hover:text-purple-600 dark:hover:text-purple-400"
              aria-label="Website"
            >
              <Icon name="lucide:globe" class="h-4.5 w-4.5" />
            </a>
          )}
          {linkedin && (
            <a
              href={linkedin}
              target="_blank"
              rel="noreferrer"
              class="text-gray-400 transition-colors hover:text-[#0077b5]"
              aria-label="LinkedIn"
            >
              <Icon name="simple-icons:linkedin" class="h-4.5 w-4.5" />
            </a>
          )}
          {twitter && (
            <a
              href={twitter}
              target="_blank"
              rel="noreferrer"
              class="text-gray-400 transition-colors hover:text-black dark:hover:text-white"
              aria-label="Twitter"
            >
              <Icon name="simple-icons:x" class="h-4.5 w-4.5" />
            </a>
          )}
        </div>
      )}
    </div>
  </div>
</div>
