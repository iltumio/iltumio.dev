---
import { Icon } from 'astro-icon/components';

interface Props {
  link: string;
  type: "Github" | "Twitter" | "LinkedIn";
  class?: string;
}

const { link, type, class: className } = Astro.props;
---

<a
  href={link}
  target="_blank"
  rel="noreferrer"
  aria-label={`${type} profile`}
  class:list={[
    "text-gray-400 hover:text-gray-900 dark:text-gray-500 dark:hover:text-white transition-colors duration-300",
    className,
  ]}
>
  {type === "Github" && <Icon name="simple-icons:github" class="w-6 h-6" />}
  {type === "Twitter" && <Icon name="simple-icons:x" class="w-6 h-6" />}
  {type === "LinkedIn" && <Icon name="simple-icons:linkedin" class="w-6 h-6" />}
</a>
