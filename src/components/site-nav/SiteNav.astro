---
import ThemeToggle from "../theme-toggle/ThemeToggle.astro";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isHome = path === "/";
const isBlog = path === "/blog" || path.startsWith("/blog/");

const itemClass = (active: boolean) =>
  [
    "relative inline-flex h-14 items-center px-2.5 sm:px-3 text-sm font-medium transition-colors rounded-sm",
    "focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600",
    active
      ? "text-gray-900 dark:text-white"
      : "text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white",
  ].join(" ");
---

<a
  href="#main-content"
  class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-3 focus:z-40 focus:rounded-md focus:bg-gray-900 focus:px-3 focus:py-2 focus:text-sm focus:font-medium focus:text-white dark:focus:bg-white dark:focus:text-gray-900"
>
  Skip to content
</a>

<header
  class="sticky top-0 z-30 border-b border-gray-200 bg-white dark:border-gray-800 dark:bg-gray-950"
>
  <div
    class="mx-auto flex h-14 max-w-5xl items-center justify-between gap-4 px-5 sm:px-6 lg:px-8"
  >
    <div class="flex min-w-0 items-center gap-4 sm:gap-8">
      <a
        href="/"
        class="inline-flex h-14 items-center text-sm font-semibold tracking-tight text-gray-900 dark:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600"
      >
        <span class="sm:hidden">iltumio</span>
        <span class="hidden sm:inline">Manuel Tumiati</span>
      </a>
      <nav aria-label="Primary" class="flex items-center">
        <a href="/" class={itemClass(isHome)} aria-current={isHome ? "page" : undefined}>
          Home
          {isHome && (
            <span
              class="absolute inset-x-3 bottom-0 h-0.5 rounded-full bg-purple-600"
              aria-hidden="true"
            />
          )}
        </a>
        <a
          href="/blog"
          class={itemClass(isBlog)}
          aria-current={isBlog ? "page" : undefined}
        >
          Blog
          {isBlog && (
            <span
              class="absolute inset-x-3 bottom-0 h-0.5 rounded-full bg-purple-600"
              aria-hidden="true"
            />
          )}
        </a>
      </nav>
    </div>
    <ThemeToggle />
  </div>
</header>
