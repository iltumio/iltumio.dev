---
import { Image } from 'astro:assets';
import ProfilePicture from "../../images/ProfilePicture.png";
import Social from "../social/Social.astro";
---

<section class="w-full">
  <div class="flex flex-col lg:flex-row items-center lg:items-start gap-8 lg:gap-10">
    <div class="profile-plate relative w-36 shrink-0 overflow-hidden rounded-2xl bg-white dark:bg-gray-800 lg:w-44">
      <div class="relative">
        <Image
          class="aspect-square w-full object-cover"
          src={ProfilePicture}
          alt="Manuel Tumiati"
          width={176}
          height={176}
          loading="eager"
        />
        <span class="profile-shine" aria-hidden="true"></span>
      </div>
      <nav
        aria-label="Social profiles"
        class="flex items-center border-t border-gray-100 dark:border-gray-700"
      >
        <Social
          class="inline-flex min-h-11 flex-1 items-center justify-center"
          link={"https://github.com/iltumio"}
          type="Github"
        />
        <Social
          class="inline-flex min-h-11 flex-1 items-center justify-center"
          link={"https://www.linkedin.com/in/manuel-tumiati/"}
          type="LinkedIn"
        />
        <Social
          class="inline-flex min-h-11 flex-1 items-center justify-center"
          link={"https://x.com/iltumio"}
          type="Twitter"
        />
      </nav>
    </div>

    <div class="flex flex-col text-center lg:text-left flex-1 space-y-5">
      <div class="space-y-1">
        <h1 class="text-4xl lg:text-5xl font-extrabold tracking-tight text-gray-900 dark:text-white text-balance">
          Manuel Tumiati
        </h1>
        <p class="text-lg lg:text-xl font-medium text-gray-600 dark:text-gray-300">
          Web3 CTO & Blockchain Engineer
        </p>
      </div>

      <p class="text-base text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl mx-auto lg:mx-0">
        I specialize in <span class="font-semibold text-gray-900 dark:text-white">blockchain architecture</span> and <span class="font-semibold text-gray-900 dark:text-white">smart contract development</span>. 
        Deeply committed to advancing digital identity through self-sovereign identity principles and <span class="font-semibold text-gray-900 dark:text-white">zero-knowledge proofs</span>.
      </p>
    </div>
  </div>
</section>
