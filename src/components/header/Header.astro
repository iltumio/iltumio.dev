---
import { Image } from 'astro:assets';
import { Icon } from 'astro-icon/components';
import ProfilePicture from "../../images/ProfilePicture.png";
import Social from "../social/Social.astro";
---

<section class="w-full">
  <div class="flex flex-col items-center gap-6 lg:flex-row lg:items-start lg:gap-10">
    <div class="profile-plate relative w-36 shrink-0 overflow-hidden rounded-2xl bg-white dark:bg-gray-800 lg:w-44">
      <div class="relative">
        <Image
          class="aspect-square w-full object-cover"
          src={ProfilePicture}
          alt="Manuel Tumiati"
          width={176}
          height={176}
          loading="eager"
        />
        <span class="profile-shine" aria-hidden="true"></span>
      </div>
      <nav
        aria-label="Social profiles"
        class="flex items-center border-t border-gray-100 dark:border-gray-700"
      >
        <Social
          class="inline-flex min-h-11 flex-1 items-center justify-center"
          link={"https://github.com/iltumio"}
          type="Github"
        />
        <Social
          class="inline-flex min-h-11 flex-1 items-center justify-center"
          link={"https://www.linkedin.com/in/manuel-tumiati/"}
          type="LinkedIn"
        />
        <Social
          class="inline-flex min-h-11 flex-1 items-center justify-center"
          link={"https://x.com/iltumio"}
          type="Twitter"
        />
      </nav>
    </div>

    <div class="flex flex-1 flex-col text-center lg:text-left">
      <div class="flex flex-col items-center gap-3 lg:flex-row lg:items-start lg:justify-between lg:gap-6">
        <div class="space-y-1">
          <h1 class="text-balance text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white lg:text-5xl">
            Manuel Tumiati
          </h1>
          <p class="text-lg font-medium text-gray-600 dark:text-gray-300 lg:text-xl">
            Web3 CTO & Blockchain Engineer
          </p>
        </div>
        <a
          href="https://calendar.mstack.cloud/share/d5a4da88"
          target="_blank"
          rel="noreferrer"
          class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-gray-900 px-3.5 py-2 text-sm font-semibold text-white transition-colors hover:bg-gray-800 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:bg-white dark:text-gray-900 dark:hover:bg-gray-100 lg:mt-1.5"
        >
          <Icon name="heroicons:calendar-days-20-solid" class="h-4 w-4" />
          Book a meeting
        </a>
      </div>

      <p class="mx-auto mt-4 max-w-2xl text-base leading-relaxed text-gray-600 dark:text-gray-400 lg:mx-0">
        I design <span class="font-semibold text-gray-900 dark:text-white">blockchain architecture</span> and <span class="font-semibold text-gray-900 dark:text-white">smart contracts</span> for <span class="font-semibold text-gray-900 dark:text-white">self-sovereign identity</span> and <span class="font-semibold text-gray-900 dark:text-white">zero-knowledge proofs</span>.
        I also work on <span class="font-semibold text-gray-900 dark:text-white">agentic compliance</span>, where software agents carry out the checks and leave a proof of what they did.
        I love <a href="/open-source" class="font-semibold text-purple-600 underline-offset-2 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:text-purple-400">open source</a> and contribute to it.
      </p>
    </div>
  </div>
</section>
