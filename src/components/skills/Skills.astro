---
import { Icon } from 'astro-icon/components';
import Skill from '../skill/Skill.astro';
import Solana from '../icons/Solana.astro';

const skills = [
  { name: "Ethereum", icon: "fa6-brands:ethereum" },
  { name: "Solana", icon: null },
  { name: "Stellar", icon: "simple-icons:stellar" },
  { name: "Rust", icon: "fa6-brands:rust" },
  { name: "Typescript", icon: "simple-icons:typescript" },
  { name: "React", icon: "fa6-brands:react" },
  { name: "React Native", icon: "fa6-brands:react" },
  { name: "Svelte", icon: "simple-icons:svelte" },
] as const;
---

<div class="flex w-full flex-col">
  <div class="mb-8 flex items-center gap-6">
    <h2 class="shrink-0 text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
      Skills & Technologies
    </h2>
    <div class="h-px flex-1 bg-gray-200 dark:bg-gray-800"></div>
  </div>

  <div class="skills-marquee -mx-5 sm:-mx-6 lg:-mx-8">
    <div class="skills-marquee-track">
      {[false, true].map((duplicate) => (
        <ul
          class="skills-marquee-set"
          aria-label={duplicate ? undefined : "Skills and technologies"}
          aria-hidden={duplicate ? "true" : undefined}
        >
          {skills.map((skill) => (
            <li>
              <Skill name={skill.name}>
                {skill.icon ? (
                  <Icon name={skill.icon} slot="icon" />
                ) : (
                  <Solana slot="icon" />
                )}
              </Skill>
            </li>
          ))}
        </ul>
      ))}
    </div>
  </div>
</div>
