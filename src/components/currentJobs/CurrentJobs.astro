---
import JobPosition from "../jobPosition/JobPosition.astro";
---

<div class="flex w-full flex-col gap-3">
  <h2 class="sr-only">Experience</h2>
  <JobPosition
    name="Zyphe Inc."
    role="Co-founder & Chief Technology Officer"
    description="Redefining digital identity with seamless, innovative solutions for everyone."
    image="/zyphe-logotype.svg"
    link="https://zyphe.com"
    linkedin="https://www.linkedin.com/company/zyphe"
    twitter="https://x.com/zyphe_official"
    from="Dec. 2024"
    to="Present"
    monochrome
  />
  <section aria-labelledby="previously-heading">
    <h3
      id="previously-heading"
      class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-gray-500 dark:text-gray-400"
    >
      Previously
    </h3>
    <div class="overflow-hidden rounded-xl border border-gray-100 bg-white dark:border-gray-800 dark:bg-gray-900">
      <JobPosition
        plain
        flush
        name="Satellite.im"
        role="Advisor, Chief Technology Officer & Software Engineer"
        image="/satellite-logo.png"
        link="https://github.com/Satellite-im"
        from="Jan. 2021"
        to="Dec. 2024"
      />
      <div class="border-t border-gray-100 dark:border-gray-800"></div>
      <JobPosition
        plain
        flush
        name="KNOBS"
        role="Chief Technology Officer, Project Manager & Senior Web Developer"
        image="/knobs-logo.png"
        link="https://knobs.it"
        from="Jul. 2018"
        to="Nov. 2024"
      />
    </div>
  </section>
</div>
