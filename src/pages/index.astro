---
import Layout from '../layouts/Layout.astro';
import Header from '../components/header/Header.astro';
import CurrentJobs from '../components/currentJobs/CurrentJobs.astro';
import Skills from '../components/skills/Skills.astro';
import Contributions from '../components/contributions/Contributions.astro';
import Cta from '../components/cta/Cta.astro';
---

<Layout
	title="Manuel Tumiati | Web3 CTO & Blockchain Engineer"
	description="Manuel Tumiati — Web3 CTO & Blockchain Engineer at Zyphe Inc. Specializing in decentralized identity, self-sovereign identity, and zero-knowledge proofs."
>
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@graph": [
			{
				"@type": "Person",
				"name": "Manuel Tumiati",
				"jobTitle": "Web3 CTO & Blockchain Engineer",
				"url": "https://iltumio.dev",
				"description": "Web3 CTO & Blockchain Engineer specializing in decentralized identity, self-sovereign identity, and zero-knowledge proofs.",
				"worksFor": {
					"@type": "Organization",
					"name": "Zyphe Inc."
				},
				"knowsAbout": ["Blockchain", "Smart Contracts", "Self-Sovereign Identity", "Zero-Knowledge Proofs", "Web3", "Digital Identity", "Decentralized Systems"],
				"sameAs": [
					"https://github.com/iltumio",
					"https://www.linkedin.com/in/manuel-tumiati/",
					"https://x.com/iltumio"
				]
			},
			{
				"@type": "WebSite",
				"name": "Manuel Tumiati",
				"url": "https://iltumio.dev"
			}
		]
	})} />
	<main id="main-content" class="flex flex-1 flex-col items-center bg-gray-50 dark:bg-gray-950 transition-colors duration-300">
		<div class="w-full max-w-5xl px-5 sm:px-6 lg:px-8 pt-8 pb-8 lg:pt-10 lg:pb-10 space-y-10 lg:space-y-12">
			<Header />
			
			<div class="space-y-10 lg:space-y-12">
				<section class="animate-fade-in-up" style="animation-delay: 0.1s">
					<Cta />
				</section>

				<section class="animate-fade-in-up" style="animation-delay: 0.2s">
					<CurrentJobs />
				</section>

				<section class="animate-fade-in-up" style="animation-delay: 0.3s">
					<Contributions />
				</section>
				
				<section class="animate-fade-in-up" style="animation-delay: 0.4s">
					<Skills />
				</section>
			</div>
		</div>
	</main>
</Layout>
