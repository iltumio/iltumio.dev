---
import Layout from "../layouts/Layout.astro";

export const prerender = true;

const projects = [
  { name: "OxiCloud", href: "https://github.com/AtalayaLabs/OxiCloud" },
  { name: "viem", href: "https://github.com/wevm/viem" },
  { name: "Apalis", href: "https://github.com/apalis-dev/apalis" },
];
---

<Layout
  title="Open source | Manuel Tumiati"
  description="Open source projects Manuel Tumiati has contributed to, including OxiCloud, viem, and Apalis."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Open source", url: "/open-source" },
  ]}
>
  <main id="main-content" class="flex flex-1 flex-col items-center bg-gray-50 transition-colors duration-300 dark:bg-gray-950">
    <div class="w-full max-w-5xl px-5 pb-12 pt-8 sm:px-6 lg:px-8 lg:pb-16 lg:pt-12">
      <header class="mb-8 max-w-2xl lg:mb-10">
        <h1 class="text-balance text-4xl font-extrabold tracking-tight text-gray-900 dark:text-white lg:text-5xl">
          Open source
        </h1>
        <p class="mt-4 text-lg leading-relaxed text-gray-600 dark:text-gray-400">
          I love open source and I contribute to it.
        </p>
      </header>

      <ul class="flex flex-col gap-3">
        {projects.map((project) => (
          <li>
            <a
              href={project.href}
              target="_blank"
              rel="noreferrer"
              class="text-lg font-semibold text-gray-900 underline-offset-2 hover:text-purple-600 hover:underline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-purple-600 dark:text-white dark:hover:text-purple-400"
            >
              {project.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </main>
</Layout>
